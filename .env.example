# Copy to .env and fill in. Every variable from tech spec §4.

# Any PostgreSQL connection string. The docker-compose db service uses:
#   postgres://app:app@db:5432/scheduler
DATABASE_URL=postgresql://app:app@localhost:5432/scheduler

# Optional, pooler-only: set when DATABASE_URL points at a connection pooler
# (e.g. Supabase port 6543). Used by Prisma for migrations against the direct
# 5432 connection. Leave unset on a long-running container with a direct URL.
DIRECT_URL=

# Auth.js session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public base URL of this deployment. Must match a Google OAuth redirect URI.
AUTH_URL=http://localhost:3000

# Set to `true` on self-hosted / container deployments (anything not on Vercel).
# Required for Auth.js to validate OAuth callbacks against AUTH_URL's origin —
# without it, Google sign-in fails with a missing `iss` (issuer) error. The
# docker-compose path defaults this to true; set it explicitly elsewhere.
AUTH_TRUST_HOST=true

# Google OAuth client credentials (Google Cloud Console → Credentials).
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bootstrap admin/allowlist owner email (seeded on first boot in Phase 4).
OWNER_EMAIL=

# Default display timezone for polls (IANA name).
APP_TIMEZONE=America/New_York
