# Copy to .env and fill in. Every variable from tech spec §4.

# Any PostgreSQL connection string. `docker compose up` starts a local Postgres
# on the default port 5432, which this URL points at for host-run dev.
DATABASE_URL=postgresql://app:app@localhost:5432/scheduler

# Behind a connection pooler (e.g. Supabase port 6543), point DATABASE_URL at the
# pooled URL for the app, and run the migrate step with DATABASE_URL set to the
# direct (non-pooled, port 5432) connection. There is no separate DIRECT_URL.

# Auth.js session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public base URL of this deployment. Must match a Google OAuth redirect URI.
AUTH_URL=http://localhost:3000

# Set to `true` on self-hosted / container deployments (anything not on Vercel).
# Required for Auth.js to validate OAuth callbacks against AUTH_URL's origin —
# without it, Google sign-in fails with a missing `iss` (issuer) error. The
# docker-compose path defaults this to true; set it explicitly elsewhere.
AUTH_TRUST_HOST=true

# Google OAuth client credentials (Google Cloud Console → Credentials).
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bootstrap admin/allowlist owner email (seeded on first boot in Phase 4). The
# owner gets `isOwner` + admin access regardless of the allowlist mode below.
OWNER_EMAIL=

# Creator-access mode (Phase 4). "true" (the default when unset) gates poll
# creation by the AllowedCreator list; "false" lets any *verified* Google login
# create polls. Either way, the email_verified gate and the blocklist still apply.
ALLOWLIST_ENABLED=true

# Timezone (IANA name) for the owner-only /admin audit-log timestamps. Polls
# carry their own timezone (chosen at create time); this doesn't affect them.
APP_TIMEZONE=America/New_York

# --- Abuse guards (Phase 10) — all optional; sensible defaults baked in. ---
# Rate limits are per app replica (in-memory): N replicas = N× the ceiling.

# Poll creation: max polls per creator per window (default 20 per 3600s).
RATE_LIMIT_CREATE_MAX=
RATE_LIMIT_CREATE_WINDOW_SECONDS=

# Voting: max submits per client IP per window (default 30 per 60s).
RATE_LIMIT_VOTE_MAX=
RATE_LIMIT_VOTE_WINDOW_SECONDS=

# Client-IP derivation for the per-IP vote limit + audit-log IPs. The app only
# sees headers, so this must match your proxy chain (docs/deployment.md):
# - CLIENT_IP_HEADER: read the IP *only* from this single-value header set by a
#   trusted edge. Cloudflare Tunnel (the k3s home deployment): cf-connecting-ip.
#   nginx with `proxy_set_header X-Real-IP $remote_addr`: x-real-ip.
# - TRUSTED_PROXY_HOPS (default 1): otherwise, take the Nth X-Forwarded-For
#   entry from the RIGHT, N = how many of your proxies append to XFF. Never the
#   leftmost entry, which the client controls.
# With no proxy in front at all, no header is trustworthy — run behind one.
# Local dev (no proxy): leave both unset; Next.js fills XFF from the socket.
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=

# Size caps (row counts, not rates). Defaults: 100 polls per creator,
# 60 time options per poll, 250 participants per poll.
MAX_POLLS_PER_CREATOR=
MAX_SLOTS_PER_POLL=
MAX_PARTICIPANTS_PER_POLL=

# DEV ONLY. When "true" (and NODE_ENV != production), exposes
# GET /api/dev/login?email=...&callbackUrl=/ to mint a session without Google —
# for local testing of the access-control flows. Ignored in production builds.
# Leave unset/false everywhere real.
ENABLE_DEV_LOGIN=false
